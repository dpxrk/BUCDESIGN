{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Buccellati Executive Presentation Design System — canonical design tokens. Single source of truth for color, typography, spacing, and grid.",
  "$version": "1.0.0",

  "color": {
    "primary": {
      "avorio":             { "$value": "#F5F1EA", "$type": "color", "$description": "Ivory — default slide background, warm off-white" },
      "neroInchiostro":     { "$value": "#1A1A1A", "$type": "color", "$description": "Ink Black — primary text, softer than pure black" },
      "pergamena":          { "$value": "#EAE2D2", "$type": "color", "$description": "Parchment — section-divider background, muted alternate" }
    },
    "accent": {
      "bluBuccellati":      { "$value": "#1B2A4E", "$type": "color", "$description": "Box Blue — derived from the silk lining of the octagonal jewellery box" },
      "oroAntico":          { "$value": "#A8894E", "$type": "color", "$description": "Antique Gold — logo-printed-in-gold accent, matte/satin tone" },
      "oroChiaro":          { "$value": "#C9A961", "$type": "color", "$description": "Light Gold — secondary gold for highlight states" }
    },
    "neutral": {
      "grafite":            { "$value": "#4A4A48", "$type": "color", "$description": "Graphite — secondary text, captions" },
      "cenere":             { "$value": "#8A8A86", "$type": "color", "$description": "Ash — tertiary text, axis labels" },
      "lino":               { "$value": "#D9D2C3", "$type": "color", "$description": "Linen — table row banding, soft fills" },
      "polvere":            { "$value": "#BFB8A8", "$type": "color", "$description": "Dust — chart background series 2" },
      "bluPolvere":         { "$value": "#7A8BA8", "$type": "color", "$description": "Powder Blue — tint of Blu Buccellati" }
    },
    "chartSeries": {
      "1": { "$value": "{color.accent.bluBuccellati}", "$type": "color" },
      "2": { "$value": "{color.accent.oroAntico}",     "$type": "color" },
      "3": { "$value": "{color.neutral.grafite}",      "$type": "color" },
      "4": { "$value": "{color.neutral.cenere}",       "$type": "color" },
      "5": { "$value": "{color.accent.oroChiaro}",     "$type": "color" },
      "6": { "$value": "{color.neutral.bluPolvere}",   "$type": "color" }
    }
  },

  "typography": {
    "fontFamily": {
      "display":  { "$value": "Trajan Pro, Cormorant Garamond, Garamond, Georgia, serif",            "$type": "fontFamily" },
      "heading":  { "$value": "Cormorant Garamond, Garamond, 'Adobe Garamond Pro', Georgia, serif",  "$type": "fontFamily" },
      "body":     { "$value": "Optima, 'Gill Sans MT', 'Gill Sans', 'Calibri Light', sans-serif",    "$type": "fontFamily" },
      "data":     { "$value": "Georgia, 'Cormorant Infant', serif",                                  "$type": "fontFamily" }
    },
    "scale": {
      "display":     { "$value": { "fontSize": "54pt", "lineHeight": 1.10, "letterSpacing": "0.12em", "fontWeight": 300 }, "$type": "typography" },
      "h1Section":   { "$value": { "fontSize": "40pt", "lineHeight": 1.15, "letterSpacing": "0.06em", "fontWeight": 400 }, "$type": "typography" },
      "h2Slide":     { "$value": { "fontSize": "28pt", "lineHeight": 1.20, "letterSpacing": "0.04em", "fontWeight": 400 }, "$type": "typography" },
      "eyebrow":     { "$value": { "fontSize": "9pt",  "lineHeight": 1.00, "letterSpacing": "0.20em", "fontWeight": 700, "textTransform": "uppercase" }, "$type": "typography" },
      "bodyLarge":   { "$value": { "fontSize": "16pt", "lineHeight": 1.40, "letterSpacing": "0",      "fontWeight": 400 }, "$type": "typography" },
      "body":        { "$value": { "fontSize": "14pt", "lineHeight": 1.40, "letterSpacing": "0",      "fontWeight": 400 }, "$type": "typography" },
      "bodySmall":   { "$value": { "fontSize": "12pt", "lineHeight": 1.40, "letterSpacing": "0",      "fontWeight": 400 }, "$type": "typography" },
      "caption":     { "$value": { "fontSize": "9pt",  "lineHeight": 1.30, "letterSpacing": "0.02em", "fontWeight": 400 }, "$type": "typography" },
      "kpiNumeral":  { "$value": { "fontSize": "72pt", "lineHeight": 1.00, "letterSpacing": "0",      "fontWeight": 300 }, "$type": "typography" }
    }
  },

  "layout": {
    "canvas": {
      "aspectRatio":  { "$value": "16:9",          "$type": "string" },
      "widthInches":  { "$value": 13.333,          "$type": "number" },
      "heightInches": { "$value": 7.5,             "$type": "number" },
      "exportProjector": { "$value": "1920x1080 @ 144dpi", "$type": "string" },
      "exportPrint":     { "$value": "300dpi PDF",         "$type": "string" }
    },
    "margin": {
      "outer":        { "$value": "0.6in", "$type": "dimension" }
    },
    "grid": {
      "columns":      { "$value": 12,      "$type": "number" },
      "columnWidth":  { "$value": "0.94in","$type": "dimension" },
      "gutter":       { "$value": "0.18in","$type": "dimension" },
      "liveWidth":    { "$value": "12.133in","$type": "dimension" },
      "liveHeight":   { "$value": "6.3in", "$type": "dimension" }
    },
    "whitespace": {
      "maxInkedRatio": { "$value": 0.40, "$type": "number", "$description": "A slide should be no more than 40% inked (text + image + chart)." }
    }
  },

  "stroke": {
    "hairline":      { "$value": "0.5pt", "$type": "dimension" },
    "rule":          { "$value": "1pt",   "$type": "dimension" },
    "iconStroke":    { "$value": "1.5pt", "$type": "dimension" }
  },

  "logo": {
    "wordmarkMinWidth": {
      "cover":   { "$value": "2.2in", "$type": "dimension" },
      "footer":  { "$value": "0.9in", "$type": "dimension" }
    },
    "clearSpace":     { "$value": "1B", "$type": "string", "$description": "Minimum clear space equals the height of one 'B' character in the mark." }
  },

  "motifs": {
    "honeycombDiameter": { "$value": "1.5in", "$type": "dimension" },
    "rigatoWidth":       { "$value": "1.5in", "$type": "dimension" }
  },

  "accessibility": {
    "minBodyType":  { "$value": "12pt", "$type": "dimension" },
    "contrast": {
      "avorioOnNero":         { "$value": "16.4:1", "$type": "string" },
      "avorioOnBluBuccellati":{ "$value": "11.7:1", "$type": "string" }
    },
    "positiveNegativeEncoding": { "$value": "Oro Antico (positive) vs Grafite (negative); never red/green", "$type": "string" }
  }
}
